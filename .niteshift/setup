#!/usr/bin/env bash
# One-shot work for a fresh sandbox: language runtimes, dependencies, the compose
# infrastructure, and a migrated, seeded database. Long-running processes are declared in
# .niteshift/services.yaml. Every step here is safe to re-run.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

NODE_PREFIX=/opt/node
NODE_VERSION="$(sed 's/^v//' .nvmrc)"
export PATH="$NODE_PREFIX/bin:$PWD/.venv/bin:$PATH"

# .env.development and .env.services are the repo's committed dev defaults; bin/start loads them
# this way for host-side processes. Django reads ClickHouse's cluster config from them, and
# migrations build the wrong DDL without it.
while IFS="=" read -r name value; do
    if [[ -n "$name" && "$name" != \#* && -z "${!name:-}" ]]; then
        export "$name=$value"
    fi
done < <(cat .env.development .env.services)
# Niteshift keeps seeded persons in the main database, matching the compose PersonHog services.
export PERSONS_DB_WRITER_URL="postgres://posthog:posthog@db:5432/posthog"
export PERSONS_DB_READER_URL="$PERSONS_DB_WRITER_URL"

# package.json wants Node 24; sandbox images ship an older one.
if [ "$(node --version 2>/dev/null || true)" != "v$NODE_VERSION" ]; then
    echo "→ Installing Node v$NODE_VERSION"
    curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-x64.tar.xz" -o /tmp/node.tar.xz
    rm -rf "$NODE_PREFIX"
    mkdir -p "$NODE_PREFIX"
    tar -xJf /tmp/node.tar.xz -C "$NODE_PREFIX" --strip-components=1
    rm -f /tmp/node.tar.xz
fi

# .env.services points every process at the compose services by container name, so those names
# have to resolve on the host too. Same list as
# docs/published/handbook/engineering/developing-locally.md.
if ! grep -q clickhouse-coordinator /etc/hosts; then
    echo "→ Adding the compose host aliases to /etc/hosts"
    echo '127.0.0.1 db redis7 kafka clickhouse clickhouse-coordinator objectstorage seaweedfs temporal' >>/etc/hosts
fi

# The frontend watchers walk the whole monorepo and exhaust the default inotify budget, which
# takes the Vite dev server down with ENOSPC.
echo "→ Raising the inotify limits"
# gVisor does not expose these kernel limit controls.
for limit in max_user_watches=1048576 max_user_instances=8192; do
    if [[ -e "/proc/sys/fs/inotify/${limit%%=*}" ]]; then
        sysctl -q -w "fs.inotify.$limit"
    fi
done

echo "→ Installing Python dependencies"
uv sync

echo "→ Installing JavaScript dependencies"
pnpm install --frozen-lockfile --prefer-offline

echo "→ Installing Playwright's Chromium"
pnpm exec playwright install chromium

# ClickHouse publishes 8443, which the sandbox already listens on. Compose appends to `ports`,
# so the whole list has to be replaced.
echo "→ Writing the compose override"
cat >docker-compose.niteshift.yml <<'YAML'
# Generated by .niteshift/setup. Not tracked.
services:
    clickhouse:
        ports: !override
            - '8123:8123'
            - '9000:9000'
            - '9009:9009'
YAML
grep -qxF docker-compose.niteshift.yml .git/info/exclude || echo docker-compose.niteshift.yml >>.git/info/exclude

echo "→ Starting the infrastructure"
ns services start db redis kafka clickhouse objectstorage personhog
bin/wait-for-docker objectstorage
echo "→ Waiting for personhog"
timeout 120 bash -c 'until (exec 3<>/dev/tcp/127.0.0.1/50052) 2>/dev/null; do sleep 1; done'

echo "→ Running migrations"
bin/migrate --scope=postgres
# Shared-database mode skips the production-only partition swap that would hide seeded persons.
DEPLOYMENT=hobby bin/migrate --scope=persons
bin/migrate --scope=clickhouse

# generate_demo_data disambiguates a colliding email into a second account, so only run it while
# the instance has no users at all.
user_count="$(docker compose -p posthog -f docker-compose.dev.yml exec -T db \
    psql -qtAX -U posthog -d posthog -c 'select count(*) from posthog_user' | tr -d '[:space:]')"
if [ "$user_count" = "0" ]; then
    echo "→ Seeding the Hedgebox demo account"
    python manage.py generate_demo_data --skip-migration-check
else
    echo "→ Demo account already seeded"
fi

# Seeds the dev personal API key and the feature flags local dev expects. Needs the demo user.
echo "→ Bootstrapping local dev extras"
bin/ensure-local-setup

echo "→ Setup complete. The app is served by the proxy service on port 8010."
