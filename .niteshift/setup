#!/usr/bin/env bash
# Niteshift runs this once to prepare a fresh sandbox. Long-running processes
# belong to .niteshift/services.yaml.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

NODE_PREFIX=/opt/node
NODE_VERSION="$(cat .nvmrc)"
export PATH="$NODE_PREFIX/bin:$PATH"
export POSTHOG_TELEMETRY_OPT_OUT=1

echo "==> Installing OS packages the dev stack requires"
# brotli decompresses the GeoLite database, psql backs
# bin/wait-for-postgres-tables, and lsof lets bin/start-frontend reclaim Vite's
# port from a stale process.
apt-get update -qq
apt-get install -y --no-install-recommends brotli postgresql-client lsof

echo "==> Raising inotify limits"
# Vite, esbuild, and the toolbar watcher exceed the default limit together,
# which makes the frontend exit with ENOSPC before it finishes booting.
sysctl -w fs.inotify.max_user_watches=1048576 >/dev/null
sysctl -w fs.inotify.max_user_instances=8192 >/dev/null

echo "==> Pointing service hostnames at the published container ports"
if ! grep -qE '^127\.0\.0\.1[[:space:]]+db[[:space:]]' /etc/hosts; then
    echo '127.0.0.1 db redis7 kafka clickhouse clickhouse-coordinator objectstorage seaweedfs temporal' >> /etc/hosts
fi

echo "==> Installing Node $NODE_VERSION"
# The sandbox image ships Node 22, but package.json requires Node 24.
if [ "$("$NODE_PREFIX/bin/node" --version 2>/dev/null || true)" != "$NODE_VERSION" ]; then
    tarball="$(mktemp -d)/node.tar.xz"
    curl -fsSL --retry 3 -o "$tarball" \
        "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.xz"
    rm -rf "$NODE_PREFIX"
    mkdir -p "$NODE_PREFIX"
    tar -xJf "$tarball" -C "$NODE_PREFIX" --strip-components=1
    rm -rf "$(dirname "$tarball")"
fi
node --version

echo "==> Installing Python dependencies"
uv sync

echo "==> Installing JavaScript dependencies"
pnpm install --frozen-lockfile --prefer-offline

echo "==> Downloading the GeoLite database"
./bin/download-mmdb

echo "==> Installing phrocs"
# bin/start requires phrocs, and the repository installer selects the binary
# version for this checkout.
command -v phrocs >/dev/null || bash tools/phrocs/install.sh

echo "==> Choosing which dev-stack processes run"
# The sandbox lacks the Rust and Node ingestion toolchains, so exclude those
# units and run Django, Vite, Celery, and the migrations. hogli dev:setup can
# replace this seed when a developer chooses a different process set.
GENERATED_MPROCS=.posthog/.generated/mprocs.yaml
if [ ! -f "$GENERATED_MPROCS" ]; then
    mkdir -p "$(dirname "$GENERATED_MPROCS")"
    cat > "$GENERATED_MPROCS" <<'YAML'
_posthog:
  intents:
    - product_analytics
  exclude_units:
    - capture
    - feature-flags
    - hypercache-server
    - property-defs-rs
    - property-vals-rs
    - personhog-replica
    - personhog-router
    - personhog-identity
    - personhog-etcd-init
    - personhog-router-leader
    - personhog-leader
    - personhog-writer
    - migrate-behavioral-cohorts
    - nodejs
    - ingestion
    - typegen
procs: {}
YAML
fi
./bin/hogli dev:generate

echo "==> Writing the sandbox docker compose override"
cat > docker-compose.niteshift.yml <<'YAML'
# Generated by .niteshift/setup and excluded from git. Rerun setup to regenerate.
services:
    # Port 8443 belongs to the sandbox, so ClickHouse must omit its TLS mapping
    # for Docker to publish the remaining ports.
    clickhouse:
        ports: !override
            - '8123:8123'
            - '9000:9000'
            - '9009:9009'

    # Django's framing header blocks the preview panel, and external browsers
    # cannot reach Vite directly. Caddy serves the app, Vite, and the flag
    # service through one origin and replaces the framing policy.
    niteshift-preview:
        image: caddy
        entrypoint: sh
        command: -c 'echo "$$CADDYFILE" > /etc/caddy/Caddyfile && exec caddy run -c /etc/caddy/Caddyfile'
        restart: on-failure
        depends_on:
            - proxy
        ports:
            - '127.0.0.1:8011:8000'
        extra_hosts:
            - 'frontend:host-gateway'
        environment:
            CADDYFILE: |
                :8000 {
                    header {
                        -X-Frame-Options
                        Content-Security-Policy "frame-ancestors 'self' https://niteshift.dev https://*.niteshift.dev"
                    }

                    @vite path /@vite/* /@react-refresh /@id/* /@fs/* /src/* /node_modules/* /__vite_ping
                    handle @vite {
                        reverse_proxy frontend:8234
                    }

                    @vite-hmr header Sec-WebSocket-Protocol *vite-hmr*
                    handle @vite-hmr {
                        reverse_proxy frontend:8234
                    }

                    @flags path /flags /flags/*
                    handle @flags {
                        reverse_proxy feature-flags:3001
                    }

                    handle {
                        reverse_proxy proxy:8000 {
                            header_up Host localhost:8000
                        }
                    }
                }
YAML
grep -qxF 'docker-compose.niteshift.yml' .git/info/exclude 2>/dev/null \
    || echo 'docker-compose.niteshift.yml' >> .git/info/exclude

echo "==> Pulling container images"
docker compose -p posthog \
    -f docker-compose.dev.yml \
    -f docker-compose.profiles.yml \
    -f docker-compose.niteshift.yml \
    pull --ignore-buildable

echo "==> Setup complete"
