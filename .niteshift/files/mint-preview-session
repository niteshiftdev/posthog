#!/usr/bin/env bash
# Niteshift `cookie-file` auth. Mints a Django session for the seeded demo user and writes it as
# Playwright storage state, so preview viewers and the agent browser land in the app rather than on
# the login screen. The session row lives in Postgres, so it survives service restarts and resumes.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."
# shellcheck source=./dev-env.sh
source .niteshift/files/dev-env.sh

python - <<'PY'
import json
import os
from importlib import import_module

import django

os.environ.setdefault("DJANGO_SETTINGS_MODULE", "posthog.settings")
django.setup()

from django.conf import settings
from django.contrib.auth import BACKEND_SESSION_KEY, HASH_SESSION_KEY, SESSION_KEY

from posthog.models import User

state_file = os.environ["NITESHIFT_AUTH_STATE_FILE"]

user = User.objects.filter(email="test@posthog.com").order_by("pk").first()
if user is None:
    raise SystemExit("no demo user to mint a session for; .niteshift/setup seeds one")

store = import_module(settings.SESSION_ENGINE).SessionStore()
store[SESSION_KEY] = str(user.pk)
store[BACKEND_SESSION_KEY] = "django.contrib.auth.backends.ModelBackend"
store[HASH_SESSION_KEY] = user.get_session_auth_hash()
store.set_expiry(60 * 60 * 24 * 30)
store.create()

state = {
    "cookies": [
        {
            "name": settings.SESSION_COOKIE_NAME,
            "value": store.session_key,
            "domain": "localhost",
            "path": "/",
            # Playwright storage state drops a cookie that carries no expiry.
            "expires": int(store.get_expiry_date().timestamp()),
            "httpOnly": True,
            "secure": False,
            "sameSite": "Lax",
        }
    ],
    "origins": [],
}
with open(state_file, "w") as f:
    json.dump(state, f, indent=2)
PY
